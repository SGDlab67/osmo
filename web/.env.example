# Addresses and the chain come from deployments/monad-testnet.json (run `npm run contracts` after a deploy).
# Set any of these only to override that, e.g. for a local anvil chain:
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC=http://127.0.0.1:8545
# NEXT_PUBLIC_OSMO=
# NEXT_PUBLIC_REGISTRY=
# NEXT_PUBLIC_WELCOME=

# Server only: the wallet allowed to call Welcome.welcome and Welcome.grant. Never commit it.
RELAYER_KEY=
